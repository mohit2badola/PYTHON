Create programs using time module: 
• Display current time using time.time(), time.ctime(), time.localtime() 
• Format time using time.strftime() with different format codes 
• Create countdown timer using time.sleep() 
• Calculate age in years, months, days from birth date 
• Find day of week for any given date 
Display results in user-friendly format with proper labels


import time

print("----- CURRENT TIME DETAILS -----")

# Current timestamp
current_timestamp = time.time()
print("Timestamp (seconds since epoch):", current_timestamp)

# Readable time
readable_time = time.ctime(current_timestamp)
print("Readable Time:", readable_time)

# Local time (structured format)
local_time = time.localtime(current_timestamp)
print("Local Time (structured):", local_time)




import time

print("\n----- FORMATTED TIME -----")

current_time = time.localtime()

print("Date (DD-MM-YYYY):", time.strftime("%d-%m-%Y", current_time))
print("Time (HH:MM:SS):", time.strftime("%H:%M:%S", current_time))
print("Day of Week:", time.strftime("%A", current_time))
print("Month Name:", time.strftime("%B", current_time))
print("Full Format:", time.strftime("%A, %d %B %Y %I:%M:%S %p", current_time))


import time

print("\n----- COUNTDOWN TIMER -----")

seconds = int(input("Enter countdown time in seconds: "))

for i in range(seconds, 0, -1):
    print("Time left:", i, "seconds")
    time.sleep(1)

print("⏰ Time's up!")